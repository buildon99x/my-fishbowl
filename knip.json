{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.js", "index.html", "vite.config.js", "src/**/*.test.js"],
  "project": ["src/**/*.js"],
  "ignore": [
    "dist/**",
    "node_modules/**",
    "src/lib/i18n.js",
    "src/features/aquarium/storage/conflict-card.js",
    "src/features/aquarium/storage/sprite-fallback.js"
  ],
  "ignoreBinaries": ["knip", "depcheck"],
  "ignoreExportsUsedInFile": true
}
