{
  "name": "my-fishbowl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings=0 && npx --yes knip --reporter compact",
    "test": "vitest run",
    "cleanup:knip": "npx --yes knip",
    "cleanup:deps": "npx --yes depcheck --ignores=\"@eslint/js,vite,vitest,eslint\"",
    "cleanup": "npm run lint && npm run cleanup:deps",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "arctic": "^3.7.0",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  }
}
